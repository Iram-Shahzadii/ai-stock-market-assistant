# Copy this file to ".env" and fill in your own values.
# .env is in .gitignore, so your keys never go to GitHub.

# Google Gemini (free key): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Redis (Celery task queue) - docker compose provides this
REDIS_URL=redis://localhost:6379/0

# Backend URL used by the React frontend
VITE_API_URL=http://localhost:8000
