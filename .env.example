# Copy this file to ".env" and fill in your own values.
# .env is in .gitignore, so your keys never go to GitHub.

# Google Gemini (free key): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# MCP market-data server: auto = start it, fall back to in-process tools if it fails; off = in-process only
MCP_MODE=auto
MAX_TOOL_CALLS=6
CACHE_TTL_SECONDS=300

# Redis (Celery task queue) - docker compose provides this (Hissa C)
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
